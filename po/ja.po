msgstr "Project-Id-Version: network-drives 1\nLanguage: ja\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=1; plural=0;\n"

msgid "Network Drives"
msgstr "ネットワークドライブ"

msgid "Drives"
msgstr "ドライブ"

msgid "Connect to shared folders on your network."
msgstr "ネットワーク上の共有フォルダーに接続します。"

msgid "Connect automatically"
msgstr "自動的に接続する"

msgid "Add Network Drive"
msgstr "ネットワークドライブを追加"

msgid "Edit Network Drive"
msgstr "ネットワークドライブを編集"

msgid "General"
msgstr "一般"

msgid "Connection"
msgstr "接続"

msgid "Options"
msgstr "オプション"

msgid "Name"
msgstr "名前"

msgid "Protocol"
msgstr "接続方式"

msgid "Server"
msgstr "サーバー"

msgid "Share"
msgstr "共有名"

msgid "Port (optional)"
msgstr "ポート（任意）"

msgid "Path"
msgstr "パス"

msgid "Username (optional)"
msgstr "ユーザー名（任意）"

msgid "Domain (optional)"
msgstr "ドメイン（任意）"

msgid "Reconnect when network becomes available"
msgstr "ネットワーク復帰時に再接続する"

msgid "Passwords are requested when connecting and can be remembered by GNOME. Disconnecting a shared connection also affects Files and other saved drives using it."
msgstr "パスワードは接続時に入力し、GNOMEに保存できます。接続を切断すると、その接続を使用している「ファイル」や他のドライブにも影響します。"

msgid "Save"
msgstr "保存"

msgid "Port must be a number between 1 and 65535."
msgstr "ポートは1〜65535の整数で入力してください。"

msgid "This drive was deleted. Close this editor and add a new drive."
msgstr "このドライブは削除されました。編集画面を閉じ、新しいドライブを追加してください。"

msgid "Delete Network Drive"
msgstr "ネットワークドライブを削除"

msgid "Delete Network Drive?"
msgstr "ネットワークドライブを削除しますか？"

msgid "Remove “%s” from your saved drives? Its files and current connection will be kept."
msgstr "保存したドライブから「%s」を削除しますか？ファイルや現在の接続は保持されます。"

msgid "Cancel"
msgstr "キャンセル"

msgid "Delete"
msgstr "削除"

msgid "Saved drives could not be read. Open settings."
msgstr "保存したドライブを読み込めません。設定を開いてください。"

msgid "No network drives yet"
msgstr "ネットワークドライブはまだありません"

msgid "Open in Files"
msgstr "「ファイル」で開く"

msgid "Disconnect"
msgstr "切断"

msgid "Connect"
msgstr "接続"

msgid "Manage Network Drives"
msgstr "ネットワークドライブを管理"

msgid "Connected"
msgstr "接続済み"

msgid "Disconnected"
msgstr "未接続"

msgid "Connecting…"
msgstr "接続中…"

msgid "Connection failed"
msgstr "接続できませんでした"

msgid "Invalid drive definition."
msgstr "ドライブの設定が不正です。"

msgid "Invalid drive ID."
msgstr "ドライブIDが不正です。"

msgid "Enter a name (up to 120 characters)."
msgstr "名前を120文字以内で入力してください。"

msgid "Choose a supported protocol."
msgstr "対応している接続方式を選択してください。"

msgid "Enter a hostname or IPv4/IPv6 address, without a URL or path."
msgstr "ホスト名またはIPv4／IPv6アドレスを入力してください。URLやパスは含めないでください。"

msgid "Enter a share name without slashes."
msgstr "スラッシュを含めずに共有名を入力してください。"

msgid "Invalid field value."
msgstr "入力項目の値が不正です。"

msgid "Remove control characters from the input."
msgstr "入力から制御文字を取り除いてください。"

msgid "Invalid connection option."
msgstr "接続オプションが不正です。"

msgid "Duplicate drive ID."
msgstr "ドライブIDが重複しています。"

msgid "Unsupported settings version."
msgstr "対応していない設定バージョンです。"

msgid "Invalid drive list."
msgstr "ドライブ一覧が不正です。"

msgid "Saved drives could not be read. Restore a valid version 1 configuration before editing."
msgstr "保存したドライブを読み込めません。編集する前に、正常なバージョン1の設定を復元してください。"

msgid "Invalid saved configuration; refusing to overwrite it."
msgstr "保存された設定が不正なため、上書きできません。"

msgid "Settings could not be saved."
msgstr "設定を保存できませんでした。"

msgid "Authentication failed. Check the username and access permissions."
msgstr "認証に失敗しました。ユーザー名とアクセス権限を確認してください。"

msgid "The server could not be found. Check its name and your network connection."
msgstr "サーバーが見つかりません。サーバー名とネットワーク接続を確認してください。"

msgid "The connection timed out. Try again when the server is available."
msgstr "接続がタイムアウトしました。サーバーが利用可能になってから再試行してください。"

msgid "The share or folder does not exist. Check the drive settings."
msgstr "共有またはフォルダーが存在しません。ドライブの設定を確認してください。"

msgid "Support for this connection is unavailable. Install the GVfs network backends."
msgstr "この接続方式を利用できません。GVfsのネットワークバックエンドをインストールしてください。"

msgid "The drive is in use. Close files on the drive and try again."
msgstr "ドライブは使用中です。ドライブ上のファイルを閉じてから再試行してください。"

msgid "The operation could not be completed. Check the server, network connection and drive settings."
msgstr "操作を完了できませんでした。サーバー、ネットワーク接続、ドライブの設定を確認してください。"

msgid "Could not connect to %s"
msgstr "「%s」に接続できませんでした"

msgid "Could not disconnect %s"
msgstr "「%s」を切断できませんでした"

msgid "Could not open Files"
msgstr "「ファイル」を開けませんでした"

